# Contact form submit endpoint
# Set this to the URL of your SiteGround (or other) mail handler that
# accepts a multipart/form-data POST with these fields:
#   name, company, email, phone, country, volume, message, consent, website
# (the "website" field is a honeypot — should be empty for legitimate submissions)
#
# If this variable is unset or empty, the contact form gracefully falls back
# to a mailto:support@muggleship.com link with the form data pre-filled in the body.
NEXT_PUBLIC_CONTACT_FORM_ACTION=

# Canonical site origin used for canonical URLs, sitemap.xml, robots.txt,
# Open Graph and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.muggleship.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to ship the
# site without analytics — no script and no cookie banner are rendered.
# GA only loads after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional HTML-tag verification codes (content="…" value only).
# Google Search Console → Settings → Ownership verification → HTML tag.
# Not needed if you verify the domain via DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → "msvalidate.01" meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
